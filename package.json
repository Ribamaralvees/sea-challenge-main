{
  "name": "sea-challenge",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "build:shared": "npm run build -w @sea/shared",
    "dev": "npm run build:shared && concurrently -n shared,api,web -c gray,blue,green \"npm run dev -w @sea/shared\" \"npm run dev -w @sea/api\" \"npm run dev -w @sea/web\"",
    "dev:web": "npm run build:shared && npm run dev -w @sea/web",
    "dev:api": "npm run build:shared && npm run dev -w @sea/api",
    "build": "npm run build:shared && npm run build -w @sea/api && npm run build -w @sea/web",
    "start:api": "npm run start -w @sea/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.app.json --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.70.1"
  }
}
